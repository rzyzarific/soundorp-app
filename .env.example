# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env.local is
# gitignored; VITE_SUPABASE_ANON_KEY is the public "anon" key, safe to ship
# to the browser — never put the service_role key in a VITE_ prefixed var.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Lemon Squeezy Pro unlock. License activation uses Lemon Squeezy's public License
# API, which needs NO API key — do not add one here (VITE_ vars are bundled into
# the public JS). These two IDs are not secret; they make activation reject license
# keys from any other store/product. Find them in the activation response's `meta`
# (or the Lemon Squeezy dashboard). Leave blank to skip the check.
VITE_LEMONSQUEEZY_STORE_ID=
VITE_LEMONSQUEEZY_PRODUCT_ID=
